# Copy this file to config/robot.local.env on each robot.
# config/robot.local.env is ignored by git, so pulls will not overwrite it.

# ROS namespace for this robot. Examples: robot1, robot2.
ROBOT_NAMESPACE=robot1

# Runtime profile loaded by src/em_robot/launch/bringup.launch.py.
EM_ROBOT_PROFILE_VALUE=real_robot

# Keep all robots/controllers that must communicate on the same ROS_DOMAIN_ID.
ROS_DOMAIN_ID_VALUE=10
